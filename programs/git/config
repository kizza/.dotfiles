[user]
  name = Keiran O'Leary
  email = hello@keiranoleary.com
[core]
  excludesfile = ~/.gitignore
  editor = nvim
  hooksPath = ~/.config/git/hooks
[pager]
  diff = delta
  log = delta
  reflog = delta
  show = delta
[interactive]
  diffFilter = delta --color-only
[fetch]
  prune = true
[push]
  default = current
  autoSetupRemote = true
[pull]
  rebase = true
[pretty]
  custom = "%C(magenta)%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(italic blue)%an%Creset"
  other = "%C(magenta)%h%Creset %s %C(green)(%ar)%Creset %C(italic blue)%an"
[init]
  defaultBranch = main
[rebase]
  autosquash = true
[mergetool "nvim"]
  cmd = nvim -f -c \"Gdiffsplit!\" \"$MERGED\"
[mergetool "fugitive"]
  cmd = nvim -f -c \"Gvdiffsplit!\" \"$MERGED\"
  trustExitTool = false
[mergetool "diffview"]
  cmd = nvim -f -c \"DiffviewOpen\" \"$MERGED\"
  trustExitTool = false
[mergetool "vscode"]
  cmd = VSCODE_CWD="$PWD" open -n -b "com.microsoft.VSCode" --args --wait $MERGED
[merge]
  tool = diffview
[mergetool]
  keepBackup = false
