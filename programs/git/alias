[alias]
  # Logs
  l = log --color --graph --pretty=custom --abbrev-commit
  ll = log --pretty=format:"%C(magenta)%h%Creset %s %C(green)(%ar)%Creset %C(blue)%an" --stat
  l1 = !git l -n 1
  l2 = !git l -n 2
  l3 = !git l -n 3
  l4 = !git l -n 4
  l5 = !git l -n 5
  l10 = !git l -n 10
  l15 = !git l -n 15
  l20 = !git l -n 20
  l25 = !git l -n 25
  latest = log -n 1

  # Shortcuts
  abort = rebase --abort
  add = add -A
  amend = commit --amend --no-edit
  assumed-unchanged = "!git ls-files -v | grep ^h"
  br = branch
  ch = checkout
  cm = commit
  continue = rebase --continue
  current = branch --show-current
  d = diff
  discard = checkout --
  discardp = checkout -p --
  files = diff-tree --no-commit-id --name-only -r
  fixup = commit --fixup
  main = !git checkout $(git trunk)
  marker = commit --allow-empty -m
  master = !git checkout $(git trunk)
  pl = pull --rebase
  pu = push
  reabse = rebase
  rollback = "!git show -s --format=%B | pbcopy && git reset HEAD~"
  s = status
  staged = diff --cached --name-only
  tracked = "!git status --untracked-files=no --porcelain | awk '{ print $2 }'"
  tree-root = "!dirname \"$(git rev-parse --path-format=absolute --git-common-dir)\""
  committed = "!f() { git show --pretty=format: --name-only \"${1:-HEAD}\"; }; f"
  unstage = reset HEAD
  unstash = stash pop
  wipe = reset --hard HEAD

  # list aliases
  la = "!git config -l | grep alias | cut -c 7-"

  # reset diff of file modes (will claim "bad input" if there are no diffs found)
  permission-reset = !git diff -p -R --no-color | grep -E \"^(diff|(old|new) mode)\" --color=never | git apply

  detail = "!f() { \
    [ -z \"$1\" ] && { echo \"$(tput setaf 1)Empty$(tput sgr0)\"; return; }; \
    commit=${1:-HEAD}; \
    echo \"$(tput setaf 5)Message:$(tput sgr0)\"; \
    printf "%s" "$(tput setaf 7)"; \
    git log -1 --format=%B \"$commit\"; \
    printf "%s" "$(tput sgr0)"; \
    echo \"$(tput setaf 5)Files:$(tput sgr0)\"; \
    printf "%s" "$(tput setaf 7)"; \
    git diff-tree --no-commit-id --name-only -r \"$commit\"; \
    printf "%s" "$(tput sgr0)"; \
    echo; \
    echo \"$(tput setaf 5)Diff:$(tput sgr0)\"; \
    git show --color \"$commit\" --pretty=format:; \
  }; f"

  review-commits = "!git-review-commits" # Support git review-commits
  trunk = "!git-trunk" # Trunk's name, --tip for the furthest forward of local and origin's
  trunk-base = "!git-trunk-base" # Where a branch left trunk

  # Sites a worktree at ~/Code/worktrees/<repo>/<slug>, the one root worktrees live under — never beside
  # the main checkout, where a throwaway is indistinguishable from a real repo. An existing branch is
  # checked out as it stands; a name git has never seen is cut fresh from the trunk furthest forward after
  # a fetch, so a new branch never forks off whatever the main checkout was sitting on. Removing one
  # leaves the branch.
  # @usage git add-worktree with/branch-name
  add-worktree = "!f() { \
    branch=\"$1\"; \
    if [ -z \"$branch\" ]; then \
      echo \"Usage: git add-worktree <branch-name>\"; \
      return 1; \
    fi; \
    root=$(git tree-root); \
    repo=$(basename \"$root\"); \
    safe_branch=$(echo \"$branch\" | tr '/' '-'); \
    worktree=\"$HOME/Code/worktrees/${repo}/${safe_branch}\"; \
    if git show-ref --verify --quiet \"refs/heads/$branch\"; then \
      git worktree add \"$worktree\" \"$branch\"; \
    else \
      git fetch origin && \
      git worktree add \"$worktree\" -b \"$branch\" \"$(git trunk --tip)\"; \
    fi; \
  }; f"

