#!/usr/bin/env zsh
#
# One list of every branch, with the worktree holding it beside it.
#
#   enter    go there — cd to the worktree, or check the branch out here
#   ctrl-t   create a worktree for this branch and go there
#   ctrl-d   delete the marked rows, or the row under the cursor when none are marked
#   ctrl-w   cycle scope: work → worktrees → finished → everything
#
# Only a path ever reaches stdout, and only when the shell should move; everything else happens in place
# and reports on stderr. The `wt` shell function is four lines because a child process cannot cd its
# parent — that is the whole reason it exists.

emulate -L zsh
setopt pipe_fail

GREEN=$'\033[32m' RED=$'\033[31m' WHITE=$'\033[37m' GREY=$'\033[90m' ITALIC=$'\033[3m' RESET=$'\033[0m'
TAB=$'\t' SEP=$'\x1f'   # a tab is IFS whitespace and would collapse empty fields, so records use \x1f
SELF=${0:A}

say() { print -r -- "$@" >&2 }

# ─── state ───────────────────────────────────────────────────────────────────────────────────────────
# The repository is read once, into memory, keyed by branch. Everything below answers from these maps,
# because asking git per branch does not scale: one call each costs 5.8s over 139 branches and three
# costs 14.3s, where the single for-each-ref here costs 0.25s.

typeset -gA HELD_BY UPSTREAM FINISHED
typeset -ga ORDER
typeset -g TRUNK TRUNK_TIP HERE HERE_BRANCH

# Two for-each-refs and nothing per branch. Anything that needs a subprocess per row — a status, a
# rev-list — costs 5.8s over 139 branches and does not belong here; ask it of one branch, on demand.
load_state() {
  TRUNK=$(git trunk)
  TRUNK_TIP=$(git trunk --tip)
  HERE=$(git rev-parse --show-toplevel 2>/dev/null)
  HERE_BRANCH=$(git branch --show-current 2>/dev/null)

  local branch worktree_path upstream track
  while IFS=$SEP read -r branch worktree_path upstream track; do
    ORDER+=("$branch")
    HELD_BY[$branch]=$worktree_path
    UPSTREAM[$branch]=$upstream
    [[ $track != gone || $branch == $TRUNK ]] || FINISHED[$branch]=gone
  done < <(git for-each-ref refs/heads --sort=-committerdate \
    --format="%(refname:short)${SEP}%(worktreepath)${SEP}%(upstream)${SEP}%(upstream:track,nobracket)")

  local ref
  for ref in ${(f)"$(git for-each-ref --merged "$TRUNK_TIP" --format='%(refname:short)' refs/heads 2>/dev/null)"}; do
    [[ $ref == $TRUNK ]] || FINISHED[$ref]=${FINISHED[$ref]:-merged}
  done
}

# ─── the list ────────────────────────────────────────────────────────────────────────────────────────
# Branch, and the worktree holding it. Nothing here forks: every value is a lookup or an expansion, which
# is what keeps the list instant at 254 branches.

in_scope() {
  case $2 in
    worktrees) [[ -n ${HELD_BY[$1]} ]] ;;
    finished)  [[ -n ${FINISHED[$1]} ]] ;;
    work)      [[ -n ${HELD_BY[$1]} || -n ${UPSTREAM[$1]} ]] ;;
    *)         true ;;
  esac
}

# One colour for the whole row — column(1) cannot see ANSI, so the choice is made here as a single
# character and traded for the escape after alignment
rows() {
  load_state
  local scope=${1:-$(read_scope)} branch worktree_path colour marker built=""

  for branch in $ORDER; do
    in_scope "$branch" "$scope" || continue
    worktree_path=${HELD_BY[$branch]}

    marker=" "
    colour=n
    if [[ -n $worktree_path && $worktree_path == $HERE ]] || [[ -z $worktree_path && $branch == $HERE_BRANCH ]]; then
      marker="*" colour=h
    elif [[ -n ${FINISHED[$branch]} ]]; then
      colour=f
    fi

    built+="${branch}${TAB}${colour}${TAB}${marker} ${branch}${TAB}${${worktree_path:+${worktree_path/#$HOME/~}}:- }"$'\n'
  done

  [[ -n $built ]] || return 0
  paste <(print -rn -- "$built" | cut -f1) \
        <(print -rn -- "$built" | cut -f2- | column -t -s"$TAB" | colourise)
}

# Trade the marker character back for the colour it stands for. column(1) pads it to one character and
# separates with two spaces, so the row itself always starts three in.
colourise() {
  local line
  while IFS= read -r line; do
    case $line in
      h*) print -r -- "${GREEN}${line:3}${RESET}" ;;
      f*) print -r -- "${ITALIC}${GREY}${line:3}${RESET}" ;;
      *)  print -r -- "${WHITE}${line:3}${RESET}" ;;
    esac
  done
}

scope_file() { print -r -- "${WT_SCOPE_FILE:-${TMPDIR:-/tmp}/wt-scope}" }
read_scope() { cat "$(scope_file)" 2>/dev/null || print work }
prompt_for() {
  case $1 in
    work) print -rn -- "Work: " ;; worktrees) print -rn -- "Worktrees: " ;;
    finished) print -rn -- "Finished: " ;; all) print -rn -- "All branches: " ;;
  esac
}

# Advance the scope and echo the prompt for it — fzf drives this from transform-prompt, so the side
# effect and the new prompt come back together
cycle_scope() {
  local next
  case $(read_scope) in
    work) next=worktrees ;; worktrees) next=finished ;; finished) next=all ;; *) next=work ;;
  esac
  print -r -- "$next" >"$(scope_file)"
  prompt_for "$next"
}

# ─── actions ─────────────────────────────────────────────────────────────────────────────────────────

# A worktree is somewhere to stand; a branch without one is checked out where you already are
go() {
  if [[ -n ${HELD_BY[$1]} ]]; then print -r -- "${HELD_BY[$1]}"; else git checkout "$1" >&2; fi
}

# Worktrees live at ~/Code/worktrees/<repo>/<slug>, one root, never beside the main checkout where a
# throwaway is indistinguishable from a real repo
create() {
  [[ -z ${HELD_BY[$1]} ]] || { print -r -- "${HELD_BY[$1]}"; return }

  local root=$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")
  local worktree_path="$HOME/Code/worktrees/${root:t}/${1//\//-}"

  git worktree add "$worktree_path" "$1" >&2 && print -r -- "$worktree_path"
}

# ─── removing ────────────────────────────────────────────────────────────────────────────────────────
# A refusal is a fork in the road, not an error to print and walk away from. Every git command that can
# fail here is wrapped, its failure read, and the ways out offered as one keystroke each.

# One key, no enter. Prints the key chosen.
choose() {
  local question=$1; shift
  say ""
  say "  ${RED}✖${RESET} $question"

  local offered="" option
  for option in "$@"; do offered+="  ${GREEN}[${option%%:*}]${RESET}${option#*:}" done
  print -rn -- "$offered  " >&2

  local key
  read -k 1 key </dev/tty 2>/dev/null || key=s
  say ""
  print -r -- "$key"
}

# Somewhere for the picker to send the shell once it closes. Only a worktree you have asked to walk into
# is ever written here; fzf is told to abort so the outer script can hand the path back.
hand_off() { print -r -- "$1" >"${WT_HANDOFF:-/dev/null}" }

# Try to take the worktree away. Returns non-zero when the branch should be left alone too — either
# because the worktree is still there, or because you are on your way to it.
drop_worktree() {
  local worktree_path=$1 failure

  if [[ $PWD == $worktree_path || $PWD == $worktree_path/* ]]; then
    case $(choose "You are standing in ${worktree_path/#$HOME/~}" \
      "m:leave for the main checkout" "s:skip") in
      m) hand_off "$(git rev-parse --path-format=absolute --git-common-dir | xargs dirname)" ;;
    esac
    return 1
  fi

  failure=$(git worktree remove "$worktree_path" 2>&1) && {
    say "${GREEN}✔${RESET} Removed ${worktree_path/#$HOME/~}"; return 0
  }

  # git says one of three things, and each has a different way out
  local question=${failure#fatal: } answer
  case $failure in
    *"modified or untracked"*)
      answer=$(choose "${worktree_path:t} has uncommitted work" \
        "g:go there" "f:force, discarding it" "s:skip") ;;
    *locked*)
      answer=$(choose "${worktree_path:t} is locked — something may be working in it" \
        "u:unlock and remove" "g:go there" "s:skip") ;;
    *)
      answer=$(choose "$question" "g:go there" "s:skip") ;;
  esac

  case $answer in
    g) hand_off "$worktree_path"; return 1 ;;
    f) git worktree remove --force "$worktree_path" >&2 &&
         { say "${GREEN}✔${RESET} Removed ${worktree_path/#$HOME/~}"; return 0 } ;;
    u) git worktree unlock "$worktree_path" >&2
       git worktree remove --force "$worktree_path" >&2 &&
         { say "${GREEN}✔${RESET} Removed ${worktree_path/#$HOME/~}"; return 0 } ;;
  esac
  return 1
}

# Finished work goes without asking; anything else is confirmed. A -d that git refuses is offered as a
# -D rather than printed and abandoned.
drop_branch() {
  local branch=$1 finished=${FINISHED[$1]} failure

  if [[ -z $finished ]]; then
    case $(choose "$branch is neither merged nor gone" "d:delete anyway" "s:keep") in
      d) git branch -D "$branch" >&2 ;;
      *) say "${GREY}kept $branch${RESET}" ;;
    esac
    return
  fi

  # merged deletes safely with -d; gone was squash-merged, which leaves git no ancestry to see
  [[ $finished != merged ]] && { git branch -D "$branch" >&2; return }

  failure=$(git branch -d "$branch" 2>&1) && { say "${GREEN}✔${RESET} Deleted $branch"; return }

  case $(choose "${failure#error: }" "d:delete anyway" "s:keep") in
    d) git branch -D "$branch" >&2 ;;
    *) say "${GREY}kept $branch${RESET}" ;;
  esac
}

# The worktree goes first — a branch a worktree holds cannot be deleted. Trunk is turned away here rather
# than deeper down, so nothing is announced that is not then attempted, and the main checkout — the
# worktree trunk is held in — is never the thing git is asked to remove.
remove() {
  local worktree_path=${HELD_BY[$1]}

  [[ $1 != $TRUNK ]] || { say "${GREY}left $1 alone — it is trunk${RESET}"; return }

  # What is about to happen, before it happens. The ✔ below and git's own lines are the result, and a
  # result arriving on its own leaves you working backwards to what was asked for.
  say ""
  if [[ -n $worktree_path ]]; then
    say "${WHITE}‣ Removing worktree ${worktree_path/#$HOME/~} and branch $1${RESET}"
  else
    say "${WHITE}‣ Deleting branch $1${RESET}"
  fi

  [[ -z $worktree_path ]] || drop_worktree "$worktree_path" || return
  drop_branch "$1"
}

pause() { print -rn -- "  ${GREY}enter to continue${RESET} " >&2; read -r _ </dev/tty 2>/dev/null || true }

remove_each() {
  load_state
  local branch
  for branch in "$@"; do
    [[ -z $branch ]] || remove "$branch"
    [[ ! -s ${WT_HANDOFF:-/dev/null} ]] || break   # on our way somewhere; stop deleting
  done
  git worktree prune
  pause
}

# What fzf should do once the removal has had its say: leave, if we are being sent to a worktree
after_remove() {
  if [[ -s ${WT_HANDOFF:-/dev/null} ]]; then print "abort"; else print "reload($SELF --rows)"; fi
}

# Keep the tail — for a path it is the filename that distinguishes it. The two status characters lead
# every line and are left alone, because the colour pass downstream reads them.
trim_left() {
  awk -v w=$(( $1 - 3 )) '{
    code = substr($0, 1, 3); path = substr($0, 4)
    print code (length(path) > w ? "…" substr(path, length(path) - w + 2) : path)
  }'
}

preview() {
  load_state
  local worktree_path=${HELD_BY[$1]}

  # bat's gitoneline grammar, the same one `branch` uses — git's own --color leaves the message at the
  # terminal default, which reads as grey against this theme
  local commits=$(git log --oneline -40 "$TRUNK_TIP..$1" 2>/dev/null |
    bat --color=always --style=plain --language=gitoneline --paging=never)
  [[ -n $commits ]] || commits="${GREY}nothing of its own — merged, or not yet committed${RESET}"

  # --no-optional-locks matters: fzf kills the preview whenever the cursor moves, and a plain status
  # killed mid-refresh leaves an index.lock behind that blocks every later git command in that repo
  local working=""
  [[ -z $worktree_path ]] || working=$(git -C "$worktree_path" --no-optional-locks status --short |
    trim_left $(( ${FZF_PREVIEW_COLUMNS:-120} * 45 / 100 )))

  # A clean worktree has no left column to give the commits room against
  [[ -n $working ]] || { print -r -- "$commits"; return }

  # Colour lands after alignment: the first two characters of a short status are staged and unstaged
  paste <(print -r -- "$working") <(print -r -- "$commits") \
    | sed $'s/^\t/ \t/' | column -t -s"$TAB" \
    | sed -E "s/^(.)(.)/$(printf '\033')[32m\1$(printf '\033')[31m\2$(printf '\033')[0m/"
}

# ─── picker ──────────────────────────────────────────────────────────────────────────────────────────

pick() {
  "$SELF" --rows | fzf --ansi --multi --layout=reverse --highlight-line --cycle \
    --marker="✓ " --pointer="❯ " \
    --delimiter="$TAB" --with-nth=2 --accept-nth=1 \
    --prompt="$(prompt_for "$(read_scope)")" \
    --footer="[CR]go there  [C-t]create a worktree  [C-d]delete  [C-w]change scope" \
    --color=footer:20 \
    --expect=ctrl-t \
    --bind "ctrl-d:execute($SELF --remove {+1})+transform($SELF --after-remove)" \
    --bind "ctrl-w:transform-prompt($SELF --cycle)+reload($SELF --rows)" \
    --preview="$SELF --preview {1}" --preview-window=down,50%,border-top
}

case ${1:-} in
  --rows)    shift; rows "$@"; exit 0 ;;
  --preview) shift; preview "$1"; exit 0 ;;
  --cycle)   cycle_scope; exit 0 ;;
  --remove)       shift; remove_each "$@"; exit 0 ;;
  --after-remove) after_remove; exit 0 ;;
esac

git rev-parse --show-toplevel >/dev/null 2>&1 || { say "${RED}✖${RESET} Not in a git repository"; exit 1 }

WT_SCOPE_FILE=$(mktemp "${TMPDIR:-/tmp}/wt-scope.XXXXX"); export WT_SCOPE_FILE
WT_HANDOFF=$(mktemp "${TMPDIR:-/tmp}/wt-handoff.XXXXX"); export WT_HANDOFF
trap 'rm -f "$WT_SCOPE_FILE" "$WT_HANDOFF"' EXIT

case ${1:-} in
  --worktrees) print worktrees ;; --finished) print finished ;; --all) print all ;; *) print work ;;
esac >"$WT_SCOPE_FILE"

# Two lines come back: the key pressed, then the branch. Nothing at all means the work happened in place.
chosen=$(pick) || true

# A removal that sent us somewhere aborts the picker, and the destination is waiting
[[ ! -s $WT_HANDOFF ]] || { cat "$WT_HANDOFF"; exit 0 }

key=${chosen%%$'\n'*} branch=${chosen#*$'\n'}
[[ -n $branch && $branch != $key ]] || exit 0

load_state
case $key in ctrl-t) create "$branch" ;; *) go "$branch" ;; esac
