#!/usr/bin/env bash
#
# Every node_modules under a directory, ranked by how long since anyone touched the project that
# owns it. `--help` is the interface; this is why it exists.
#
# `clean_node_modules` beside this answers a different question — *this project, all of it* — and
# takes the directory you are standing in. This one is for the archive: a hundred repositories where
# the ones worth clearing are the ones nobody has committed to in a year, and the ones to leave alone
# are whatever you were working on last week.

set -euo pipefail

usage() {
  cat <<'USAGE'
stale_node_modules — every node_modules under a directory, oldest project first.

  stale_node_modules <directory> [--days N] [--all] [--delete]

  <directory>  Where to scan. Required, and deliberately has no default: which
               node_modules may go depends entirely on which tree you meant, and
               a default is a guess at that made somewhere you cannot see it.

  --days N     How long a project must have gone untouched to be listed.
               Default 365.
  --all        List every node_modules whatever its age, including the projects
               normally skipped for sharing a package store.
  --delete     Remove what was listed, after confirming. Without it nothing is
               deleted and the listing is all you get.
  --help       This.

Age is the owning project's last commit, not the directory's mtime. A node_modules
is rewritten by every install and every dev server, so its own timestamp says when
a tool last ran rather than when the work was last alive — the opposite of what is
being asked.

Projects whose .yarnrc.yml sets `nodeLinker: pnpm` or `pnp` are skipped: their
packages are hardlinked out of one shared store, so `du` reports the same bytes
once per worktree, clearing them reclaims a fraction of that, and putting it back
costs a full install. --all lists them anyway. Bun's clonefile backend shares the
same way and cannot be detected from a config file, so a bun project is listed and
will over-report.

Examples:
  stale_node_modules ~/Code                 what has gone a year untouched
  stale_node_modules ~/Code/kizza --days 30 a narrower sweep of one tree
  stale_node_modules ~/Code --all           everything, sharing included
  stale_node_modules ~/Code --delete        clear the year-old ones, on a Y
USAGE
}

root=""
days=365
remove=false
everything=false

while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --days) days="${2:?--days needs a number}"; shift 2 ;;
    --delete) remove=true; shift ;;
    --all) everything=true; shift ;;
    -*) printf 'stale_node_modules: no such flag — %s\n\n' "$1" >&2; usage >&2; exit 1 ;;
    *)
      [ -z "$root" ] || { printf 'stale_node_modules: one directory at a time — already had %s\n' "$root" >&2; exit 1; }
      root="$1"; shift ;;
  esac
done

# Saying nothing and scanning somewhere of its own choosing is the one behaviour this must not have:
# the command deletes things, and where it was pointed has to be something you typed.
[ -n "$root" ] || { printf 'stale_node_modules: name a directory to scan.\n\n' >&2; usage >&2; exit 1; }

[ -d "$root" ] || { printf 'stale_node_modules: no such directory — %s\n' "$root" >&2; exit 1; }

case "$days" in
  ''|*[!0-9]*) printf 'stale_node_modules: --days wants a whole number of days — got %s\n' "$days" >&2; exit 1 ;;
esac

# `date` here may be GNU's, from coreutils, whose -r takes a file rather than an epoch. One of the
# two spellings works on any machine this runs on, and which one is not worth asking twice.
human_date() {
  date -d "@$1" +%Y-%m-%d 2>/dev/null || date -r "$1" +%Y-%m-%d
}

now=$(date +%s)
cutoff=$((now - days * 86400))

# A project whose packages are hardlinked out of a shared store has already paid for them once, so
# clearing it reclaims a fraction of what `du` reports and costs a full install to undo. Yarn's pnpm
# linker is the one in use here; bun's clonefile backend is the same idea and the same answer.
shares_a_store() {
  local project="$1"
  [ -f "$project/.yarnrc.yml" ] && grep -qE '^\s*nodeLinker:\s*(pnpm|pnp)\s*$' "$project/.yarnrc.yml"
}

# The directory the node_modules belongs to: its git root where there is one, so that a monorepo's
# packages age with the repository rather than each reporting whatever its own subdirectory last saw.
owning_project() {
  local directory="$1"
  git -C "$directory" rev-parse --show-toplevel 2>/dev/null || printf '%s' "$directory"
}

# When the project was last alive, in epoch seconds, and always a number: every caller compares it.
#
# The last commit where there is one. Failing that the directory's mtime, which needs both spellings
# of stat — GNU's is `-c %Y` and BSD's `-f %m`, and GNU's answer to `-f` is to print a line of its
# own to stdout before failing, so the output is checked for being a number rather than the exit
# status being trusted. A repository with no commits yet lands here too, and reads as very old.
last_touched() {
  local project="$1" when

  when=$(git -C "$project" log -1 --format=%ct 2>/dev/null) || when=""
  [ -z "$when" ] && when=$(stat -c %Y "$project" 2>/dev/null) || true
  [ -z "$when" ] && when=$(stat -f %m "$project" 2>/dev/null) || true

  case "$when" in
    ''|*[!0-9]*) printf '0' ;;
    *) printf '%s' "$when" ;;
  esac
}

printf 'Scanning %s for node_modules…\n\n' "$root" >&2

rows=$(
  find "$root" -type d -name node_modules -prune 2>/dev/null | while IFS= read -r modules; do
    project=$(owning_project "$(dirname "$modules")")
    shares_a_store "$project" && ! $everything && continue

    last=$(last_touched "$project")
    $everything || [ "$last" -lt "$cutoff" ] || continue

    kb=$(du -sk "$modules" 2>/dev/null | cut -f1) || continue
    printf '%s\t%s\t%s\n' "$last" "$kb" "$modules"
  done | sort -n
)

if [ -z "$rows" ]; then
  printf 'Nothing older than %s days. Try --days, or --all to see everything.\n' "$days" >&2
  exit 0
fi

printf '%-12s %10s  %s\n' "LAST COMMIT" "SIZE" "NODE_MODULES"
printf '%s\n' "$rows" | while IFS=$'\t' read -r last kb path; do
  printf '%-12s %9.1fM  %s\n' "$(human_date "$last")" "$(echo "$kb/1024" | bc -l)" "${path/#$HOME/~}"
done

total=$(printf '%s\n' "$rows" | awk -F'\t' '{s+=$2} END {printf "%.1f", s/1024/1024}')
count=$(printf '%s\n' "$rows" | wc -l | tr -d ' ')
printf '\n%s directories, %s GB\n' "$count" "$total"

$remove || { printf '\nNothing deleted. Add --delete to remove these.\n'; exit 0; }

printf '\nDelete all %s? Type Y to confirm: ' "$count"
read -r answer
[ "$answer" = "Y" ] || { printf 'Cancelled.\n'; exit 0; }

printf '%s\n' "$rows" | while IFS=$'\t' read -r _ _ path; do
  printf 'Removing %s\n' "${path/#$HOME/~}"
  rm -rf -- "$path"
done

printf 'Reclaimed %s GB.\n' "$total"
