#!/usr/bin/env bash
set -euo pipefail

if in_a_meeting; then
  echo "No vocalisation, as a microphone or camera is live (don't want to interrupt meetings!)"
  exit 0
fi

VOICE="${PIPER_VOICE:-$HOME/.config/piper/voices/alba-medium.onnx}"
PIPER_URL="${PIPER_URL:-http://127.0.0.1:5100}" # The launchd piper-server, from programs/piper
PLAY_CMD="ffplay -autoexit -nodisp -loglevel quiet -f s16le -ar 22050 -ch_layout mono -"

usage() {
  cat <<EOF
Usage: $(basename "$0") [options] [text...]

Read text aloud using Piper TTS.

Options:
  -v, --voice PATH   ONNX voice file (default: \$PIPER_VOICE or alba-medium)
  -l, --voices       List available voices
  -h, --help         Show this help

If no text is given, reads from stdin.
EOF
  exit 0
}

list_models() {
  local voices="${HOME}/.config/piper/voices"
  if [[ -d "$voices" ]]; then
    ls "$voices"/*.onnx 2>/dev/null | sed 's|.*/||; s|\.onnx$||' || true
  fi
  exit 0
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage ;;
    -l|--voices) list_models ;;
    -v|--voice) VOICE="$2"; shift 2 ;;
    --) shift; break ;;
    -*) echo "Unknown option: $1" >&2; usage; exit 1 ;;
    *) break ;;
  esac
done

if [[ ! -f "$VOICE" ]]; then
  echo "Voice not found: $VOICE" >&2
  exit 1
fi

speak_through_server() {
  curl -sf --connect-timeout 0.2 --url-query "voice=$(basename "$VOICE" .onnx)" --data-binary @- "$PIPER_URL" >/dev/null
}

speak_through_cli() {
  local PIPER_BIN
  PIPER_BIN="$(python3 -m site --user-base)/bin/piper"

  if [[ ! -x "$PIPER_BIN" ]]; then
    echo "piper binary not found at $PIPER_BIN" >&2
    echo "Install with: python3 -m pip install --user piper-tts" >&2
    exit 1
  fi

  "$PIPER_BIN" --model "$VOICE" --output-raw | $PLAY_CMD
}

if [[ $# -gt 0 ]]; then
  text="$*"
else
  text="$(cat)"
fi

# The server speaks in the background and returns at once; the CLI blocks, loading the voice every line.
printf '%s' "$text" | speak_through_server 2>/dev/null && exit 0

printf '%s' "$text" | speak_through_cli
